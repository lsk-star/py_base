APP_APP__NAME=App
APP_APP__ENVIRONMENT=local
APP_APP__DEBUG=false
APP_APP__API_PREFIX=/api/v1
APP_APP__HOST=127.0.0.1
APP_APP__PORT=8000

APP_LOGGING__LEVEL=INFO
APP_LOGGING__FORMAT=json
APP_LOGGING__ACCESS_LOG=true
APP_LOGGING__MAX_QUERY_VALUE_LENGTH=200

# 分布式追踪未接入时保持关闭；启用后仅透传上游 trace_id。
APP_TRACING__ENABLED=false

# 数据库默认使用 MySQL，未启用时不会建立连接。
APP_DATABASE__ENABLED=false
APP_DATABASE__URL=mysql+asyncmy://root:root@127.0.0.1:3306/app
APP_DATABASE__STRICT_STARTUP=true
APP_DATABASE__ECHO=false
APP_DATABASE__POOL_SIZE=5
APP_DATABASE__MAX_OVERFLOW=10