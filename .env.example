PYBASE_APP__NAME=PyBase
PYBASE_APP__ENVIRONMENT=local
PYBASE_APP__DEBUG=false
PYBASE_APP__API_PREFIX=/api/v1
PYBASE_APP__HOST=127.0.0.1
PYBASE_APP__PORT=8000

PYBASE_LOGGING__LEVEL=INFO
PYBASE_LOGGING__FORMAT=json
PYBASE_LOGGING__ACCESS_LOG=true
PYBASE_LOGGING__MAX_QUERY_VALUE_LENGTH=200

# 分布式追踪未接入时保持关闭；启用后仅透传上游 trace_id。
PYBASE_TRACING__ENABLED=false

# 数据库能力默认关闭，未启用时不会建立连接。
PYBASE_DATABASE__ENABLED=false
PYBASE_DATABASE__URL=
PYBASE_DATABASE__STRICT_STARTUP=true
PYBASE_DATABASE__ECHO=false
PYBASE_DATABASE__POOL_SIZE=5
PYBASE_DATABASE__MAX_OVERFLOW=10
